# ============================================
# 🗄️ MONGODB CONFIGURATION (REQUIRED!)
# ============================================
# Get this from MongoDB Atlas
# Atlas → Your Cluster → Connect → Drivers
# Copy the connection string and paste here
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/omniai?retryWrites=true&w=majority
MONGO_FALLBACK_URI=mongodb://127.0.0.1:27017/omniai
ALLOW_START_WITHOUT_DB=true

# ============================================
# 🔐 JWT SECRETS (REQUIRED!)
# ============================================
# Generate random strings (32+ characters)
# Use: openssl rand -base64 32
JWT_SECRET=your_super_long_random_secret_key_here_32_chars_minimum
JWT_REFRESH_SECRET=your_refresh_super_long_random_secret_key_here_32_chars_minimum
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
AUTH_DEV_PASSWORD_REPAIR=false

# Development recovery accounts used by npm run reset-auth-system.
# Put real passwords only in server/.env, never in Git.
ADMIN_PASSWORD=replace_with_local_password
RANYME_PASSWORD=replace_with_local_password
NAJET_PASSWORD=replace_with_local_password
COMPTABLE_PASSWORD=replace_with_local_password

# ============================================
# 🌍 APPLICATION CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ============================================
# 🤖 GROK / xAI CONFIGURATION
# ============================================
XAI_API_KEY=your_xai_key_here
XAI_MODEL=grok-4

# ============================================
# 📧 EMAIL CONFIGURATION (Gmail SMTP)
# ============================================
# Use a Gmail App Password here, not your normal Gmail password.
# Google no longer supports "less secure apps" for this flow.
EMAIL_USER=example@gmail.com
EMAIL_PASSWORD=app_password_here
# EMAIL_PASS is still accepted for backwards compatibility.
EMAIL_PASS=
EMAIL_FROM_NAME=OmniAI Platform
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Optional AI providers
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
ML_SERVICE_URL=http://127.0.0.1:5001
FLASK_AI_URL=http://127.0.0.1:5001
BACKEND_URL=http://localhost:5000
API_URL=http://localhost:5000/api

# Twilio for SMS / WhatsApp OTP
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SMS_FROM=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

